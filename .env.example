# ── Health check ──────────────────────────────────────────────────────────────
# The /recipeVaultHealth endpoint on your production server
HEALTH_URL=https://nutrition-rag-chatbot.onrender.com/recipeVaultHealth

# Request timeout in seconds (recipe page fetch can take ~5s on Render)
HEALTH_TIMEOUT_SECS=30

# Override the hardcoded recipe URL used inside /recipeVaultHealth (optional)
# Default: https://www.instagram.com/p/DXtUwz_DCiQ/
# HEALTH_CHECK_RECIPE_URL=https://www.instagram.com/p/DXtUwz_DCiQ/

# ── WhatsApp alerts via CallMeBot ─────────────────────────────────────────────
# Activation (one-time):
#   1. Save +34 644 59 77 59 as a WhatsApp contact
#   2. Send: "I allow callmebot to send me messages"
#   3. You'll receive your APIKEY in the reply

# Your phone number with country code — no + or spaces
# Example: India +91 98765 43210 → 919876543210
WHATSAPP_PHONE=91XXXXXXXXXX

# The API key CallMeBot sent you
WHATSAPP_APIKEY=123456
