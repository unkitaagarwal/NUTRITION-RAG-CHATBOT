# OpenAI
OPENAI_API_KEY=sk-...

# NutriLens Firebase (project: nutrilensai-77be2)
# 1. Firebase Console → Project Settings → Service accounts → Generate new private key
# 2. Save as nutrilens_firebase_service_account.json (do NOT commit)
# 3. Confirm bucket name under Storage → Files (copy gs:// bucket name)
FIREBASE_PROJECT_ID=nutrilensai-77be2
FIREBASE_SERVICE_ACCOUNT_JSON=nutrilens_firebase_service_account.json
FIREBASE_STORAGE_BUCKET=nutrilensai-77be2.appspot.com
# Object prefix under the bucket (default matches existing generated-meals/ folder)
# FIREBASE_MEAL_IMAGE_PREFIX=generated-meals

# Optional meal image fallback when DALL·E or upload fails
DEFAULT_MEAL_IMAGE_URL=

# Set to 1 to skip Firebase uploads (debug only)
# DISABLE_MEAL_IMAGE_PERSISTENCE=0
