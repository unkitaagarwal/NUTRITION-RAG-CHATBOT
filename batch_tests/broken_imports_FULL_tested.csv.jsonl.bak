{"url": "https://www.halfbakedharvest.com/breakfast-grilled-cheese/", "status": "success", "summary": {"http": 200, "seconds": 0.3, "name": "Breakfast Grilled Cheese with soft Scrambled Eggs and Pesto", "n_ingredients": 10, "n_steps": 1, "method": "jsonld", "cached": true, "sample_ingredients": ["4  large eggs", "kosher salt", "4 tablespoons butter, at room temperature"], "sample_steps": ["1. Whisk together the eggs and a pinch of salt in a medium bowl.2. Melt 1 tablespoon butter in a large skillet over medi"]}, "full_response": {"cached": true, "extraction": {"confidence": 0.7, "method": "jsonld"}, "recipe": {"cook_time": "5 mins", "cuisine": "American", "description": "vegetarian high protein low carb keto balanced Breakfast Grilled Cheese with soft Scrambled Eggs an.", "diet_flags": ["Vegetarian", "High Protein", "Low Carb", "Keto", "Balanced"], "ingredients": [{"name": "4  large eggs", "quantity": ""}, {"name": "kosher salt", "quantity": ""}, {"name": "4 tablespoons butter, at room temperature", "quantity": ""}, {"name": "crushed red pepper flakes, to taste", "quantity": ""}, {"name": "4 slices sourdough bread", "quantity": ""}, {"name": "1/2 cup shredded sharp cheddar cheese", "quantity": ""}, {"name": "1/2 cup shredded havarti or fontina cheese", "quantity": ""}, {"name": "1/2 cup basil pesto", "quantity": ""}, {"name": "2 tablespoons fresh chopped chives", "quantity": ""}, {"name": "honey, for drizzling", "quantity": ""}], "instructions": ["1. Whisk together the eggs and a pinch of salt in a medium bowl.2. Melt 1 tablespoon butter in a large skillet over medium heat. Add the eggs and cook, undisturbed, until a thin layer of cooked egg appears around the edge of the skillet. Using a rubber spatula gently push/move the eggs around the skillet until fluffy and barely set, about 2 minutes. Immediately remove from the skillet and sprinkle with crushed red pepper flakes.&nbsp;3.&nbsp;Spread the outside of each slice of bread with butter. On the inside of half of the slices of bread, evenly layer the cheeses, eggs, and pesto. Add the top piece of bread, buttered side facing up.3. Place the sandwiches, one at a time, in the skillet and cook until golden on each side, about 4-5 minutes per side.&nbsp;Serve topped with chives, honey, and sea salt.&nbsp;"], "meal_type": "Breakfast", "name": "Breakfast Grilled Cheese with soft Scrambled Eggs and Pesto", "nutrition": {"calcium_mg": "400", "calories": "1169", "carbs_g": "80", "cholesterol_mg": "460", "fat_g": "76", "fiber_g": "4", "iron_mg": "2", "potassium_mg": "400", "protein_g": "44", "saturated_fat_g": "34", "sodium_mg": "873", "sugar_g": "7", "vitamin_a_mcg": "600", "vitamin_c_mg": "2", "vitamin_d_mcg": "1"}, "prep_time": "10 mins", "servings": "2 sandwiches", "total_time": "15 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2Fc45890c77c7b4cb8a28b974c2fc96cf5.jpg?alt=media", "provider": "www.halfbakedharvest.com", "source_type": "Manual", "title": "Breakfast Grilled Cheese with soft Scrambled Eggs and Pesto", "type": "webpage", "url": "https://www.halfbakedharvest.com/breakfast-grilled-cheese/"}, "tags": ["Vegetarian", "High Protein", "Quick", "Easy"], "transcript": null}}
{"url": "https://www.halfbakedharvest.com/tuscan-chicken-pasta/", "status": "success", "summary": {"http": 200, "seconds": 9.1, "name": "Spicy Tuscan Chicken Pasta", "n_ingredients": 14, "n_steps": 1, "method": "jsonld", "cached": false, "sample_ingredients": ["1 jar (8 ounce)  oil-packed sun-dried tomatoes", "1 pound boneless skinless chicken breasts, cubed", "4 teaspoons Italian seasoning  ((see note))"], "sample_steps": ["1. Drain 3 tablespoons of oil from the sun-dried tomato jar into a large pot or skillet with sides. Chop the sun-dried t"]}, "full_response": {"extraction": {"confidence": 0.7, "method": "jsonld"}, "recipe": {"cook_time": "25 mins", "cuisine": "American", "description": "high protein low carb keto balanced Spicy Tuscan Chicken Pasta.", "diet_flags": ["High Protein", "Low Carb", "Keto", "Balanced"], "ingredients": [{"name": "1 jar (8 ounce)  oil-packed sun-dried tomatoes", "quantity": ""}, {"name": "1 pound boneless skinless chicken breasts, cubed", "quantity": ""}, {"name": "4 teaspoons Italian seasoning  ((see note))", "quantity": ""}, {"name": "1 teaspoon paprika or smoked paprika", "quantity": ""}, {"name": "red pepper flakes", "quantity": ""}, {"name": "kosher salt and black pepper", "quantity": ""}, {"name": "1 cup grated parmesan cheese", "quantity": ""}, {"name": "2 tablespoons salted butter", "quantity": ""}, {"name": "1  medium shallot, chopped", "quantity": ""}, {"name": "2 cloves garlic, chopped", "quantity": ""}, {"name": "2-3 tablespoons crushed Calabrian chili paste", "quantity": ""}, {"name": "1 pound short cut pasta", "quantity": ""}, {"name": "1 cup heavy cream", "quantity": ""}, {"name": "2 cups fresh baby spinach", "quantity": ""}], "instructions": ["1. Drain 3 tablespoons of oil from the sun-dried tomato jar into a large pot or skillet with sides. Chop the sun-dried tomatoes and set aside.2. Set the pot over medium-high heat. Add the chicken, 3 teaspoons Italian seasoning, the paprika, and a pinch each of red pepper flakes, salt, and pepper. Cook until golden brown, 5 minutes. Add 1/4 cup parmesan, cook another minute, then remove the chicken from the pot.3. To the same pot, add a drizzle of oil and the butter. Add the shallot, garlic, Calabrian chili paste, and 1 teaspoon of Italian seasoning. Cook until fragrant, about 3 minutes. Add 3 1/2 cups water. Bring to a boil, add the pasta, and cook, stirring often, until the pasta is al dente, 8 minutes. Stir in the cream, spinach, chopped sun-dried tomatoes, and remaining 3/4 cup parmesan. Slide the chicken in, and any juices left on the plate.4. Serve the pasta topped with fresh parmesan and basil."], "meal_type": "Lunch / Dinner", "name": "Spicy Tuscan Chicken Pasta", "nutrition": {"calcium_mg": "300", "calories": "622", "carbs_g": "60", "cholesterol_mg": "120", "fat_g": "30", "fiber_g": "3", "iron_mg": "2", "potassium_mg": "800", "protein_g": "40", "saturated_fat_g": "15", "sodium_mg": "800", "sugar_g": "2", "vitamin_a_mcg": "600", "vitamin_c_mg": "10", "vitamin_d_mcg": "0"}, "prep_time": "20 mins", "servings": "6", "total_time": "45 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F401b81d8fe1b499882175f095c997086.jpg?alt=media", "provider": "www.halfbakedharvest.com", "source_type": "Manual", "title": "Spicy Tuscan Chicken Pasta", "type": "webpage", "url": "https://www.halfbakedharvest.com/tuscan-chicken-pasta/"}, "tags": ["High Protein", "Easy"], "transcript": null}}
