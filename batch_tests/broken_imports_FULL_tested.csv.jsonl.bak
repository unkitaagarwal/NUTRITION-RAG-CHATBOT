{"url": "https://www.halfbakedharvest.com/slow-cooker-hearty-chicken-soup/", "status": "success", "summary": {"http": 200, "seconds": 8.9, "name": "Slow Cooker Hearty Chicken Soup", "n_ingredients": 17, "n_steps": 1, "method": "jsonld", "cached": false, "sample_ingredients": ["6 cups low sodium chicken stock", "2 tablespoons butter", "2 tablespoons extra virgin olive oil"], "sample_steps": ["1. In the bowl of your crockpot, combine the chicken stock, butter, olive oil, onions, carrots, parsnips, celery, leeks,"]}, "full_response": {"extraction": {"confidence": 0.7, "method": "jsonld"}, "recipe": {"cook_time": "240 mins", "cuisine": "American", "description": "high protein low carb keto gluten free balanced Slow Cooker Hearty Chicken Soup.", "diet_flags": ["High Protein", "Low Carb", "Keto", "Gluten Free", "Balanced"], "ingredients": [{"name": "6 cups low sodium chicken stock", "quantity": ""}, {"name": "2 tablespoons butter", "quantity": ""}, {"name": "2 tablespoons extra virgin olive oil", "quantity": ""}, {"name": "2  onions, chopped", "quantity": ""}, {"name": "4  carrots, chopped", "quantity": ""}, {"name": "2  parsnips, chopped", "quantity": ""}, {"name": "2  ribs celery, chopped", "quantity": ""}, {"name": "2  leeks, chopped", "quantity": ""}, {"name": "8  peppercorns", "quantity": ""}, {"name": "1  bay leaf", "quantity": ""}, {"name": "4  sprigs fresh thyme", "quantity": ""}, {"name": "2  sprigs fresh rosemary", "quantity": ""}, {"name": "2-3 pounds bone-in chicken breasts or thighs", "quantity": ""}, {"name": "kosher salt and black pepper", "quantity": ""}, {"name": "juice + zest of 1 lemon", "quantity": ""}, {"name": "3/4 cup dry farro", "quantity": ""}, {"name": "1/2 cup fresh cilantro and or mixed herbs", "quantity": ""}], "instructions": ["1. In the bowl of your crockpot, combine the chicken stock, butter, olive oil, onions, carrots, parsnips, celery, leeks, peppercorns, bay leaf, thyme, rosemary, and a pinch each of salt and pepper. Add the chicken. Cover and cook on low for 5-6 hours or high for 4-5 hours. 2. About 45 minutes before serving, remove the chicken from the soup. Remove the herbs and discard. Stir in the lemon juice and zest, plus the farro. Shred the chicken and stir it back into the soup and cook until the farro is tender.3. Divide the soup among bowls and top with herbs. Serve with a hunk of bread.&nbsp;"], "meal_type": "Lunch / Dinner", "name": "Slow Cooker Hearty Chicken Soup", "nutrition": {"calcium_mg": "50", "calories": "382", "carbs_g": "30", "cholesterol_mg": "203", "fat_g": "47", "fiber_g": "14", "iron_mg": "2", "potassium_mg": "800", "protein_g": "45", "saturated_fat_g": "4", "sodium_mg": "393", "sugar_g": "12", "vitamin_a_mcg": "900", "vitamin_c_mg": "15", "vitamin_d_mcg": "0"}, "prep_time": "15 mins", "servings": "8 servings", "total_time": "255 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2Fb7d9c40ef1534be08c8934c9faa14ab1.jpg?alt=media", "provider": "www.halfbakedharvest.com", "source_type": "Manual", "title": "Slow Cooker Hearty Chicken Soup", "type": "webpage", "url": "https://www.halfbakedharvest.com/slow-cooker-hearty-chicken-soup/"}, "tags": ["High Protein", "Hard"], "transcript": null}}
{"url": "https://www.instagram.com/reel/Da5ogE4B5F9/", "status": "success", "summary": {"http": 200, "seconds": 10.3, "name": "Hot Honey Mac & Cheese", "n_ingredients": 16, "n_steps": 9, "method": "caption_llm+video_frames_vision", "cached": false, "sample_ingredients": ["½ cup (≈170g) honey", "¼ cup (≈60g) Frank’s RedHot", "1 tsp chili flakes"], "sample_steps": ["Make the hot honey by combining honey, Frank’s RedHot, and chili flakes in a bowl.", "Cook the pasta according to package instructions."]}, "full_response": {"extraction": {"confidence": 0.5, "method": "caption_llm+video_frames_vision"}, "language": "en", "meta": {"description": "If you haven’t made this yet… what are you waiting for? 😆😛\n\nThe mac & cheese that broke Instagram 🧀🔥\n\nRecipe below 👇🏽\n\nHot Honey\n\n• ½ cup honey (≈170g)\n• ¼ cup Frank’s RedHot (≈60g)\n• 1 tsp chili flakes\n\nMac & Cheese\n\n• 850g pasta (about 2½ packs)\n• 4 tbsp butter (≈57g)\n• 4 tbsp flour (≈32g)\n• 3 cups milk (≈720g)\n• 2 tbsp chipotle in adobo\n• 1 Knorr chicken bouillon cube\n\nMake a roux by melting butter, whisking in flour, then slowly adding milk until smooth and creamy.\n\nMac Seasoning\n\n• 1 tsp each: smoked paprika, garlic powder, salt & pepper\n\nCheese Blend\n\n• 1 cup mozzarella (≈113g)\n• 1 cup fontina (≈113g)\n• 1 cup marble cheddar (≈113g)\n\nFull method already posted 👆🏽\nSave this one for later!\n\nVideo by arsenioeats", "duration": 22.06599998474121, "extractor": "Instagram", "language": "en", "provider": "www.instagram.com", "thumbnail": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F2fcfe35b22494420b40c22dd10c4b0c5.jpg?alt=media", "title": "Video by arsenioeats", "webpage_url": "https://www.instagram.com/reel/Da5ogE4B5F9"}, "recipe": {"cook_time": "30", "cuisine": "American", "description": "high protein Hot Honey Mac & Cheese.", "diet_flags": ["High Protein"], "ingredients": [{"name": "honey", "quantity": "½ cup (≈170g)"}, {"name": "Frank’s 