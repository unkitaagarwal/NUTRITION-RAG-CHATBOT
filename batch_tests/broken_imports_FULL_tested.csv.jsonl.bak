{"url": "https://www.instagram.com/reel/DdO_dtaoiI3/", "status": "success", "summary": {"http": 200, "seconds": 6.4, "name": "Copycat Starbucks Potato Cheddar Chive Bakes", "n_ingredients": 12, "n_steps": 7, "method": "caption_llm+video_frames_vision", "cached": false, "sample_ingredients": ["1 lb, diced small red potatoes", "1 tsp smoked paprika", "1 tsp garlic powder"], "sample_steps": ["Step 1: Preheat the oven and prepare a baking sheet with diced red potatoes.", "Step 2: Season the potatoes with smoked paprika, garlic powder, black pepper, and salt. Spray with avocado oil."]}, "full_response": {"extraction": {"confidence": 0.5, "method": "caption_llm+video_frames_vision"}, "language": "en", "meta": {"description": "copycat starbucks potato cheddar chive bakes 🤤\n\nFor the potatoes\n1 lb red potatoes, diced small \n1 tsp smoked paprika\n1 tsp garlic powder\n1/2 tsp black pepper\n1 tsp salt\nAvocado oil spray\n\nFor the egg mixture \n8 large eggs\n1 cup cottage cheese\n1/2 tsp onion powder\n1/2 tsp salt  \n\nFor the topping\n1 cup shredded white cheddar cheese\n3 tbsp chopped fresh chives\n\nfull recipe is up on my site! caileeeats.com 🫶🏻 \n\n#mealprepbreakfastidea #copycatstarbuckseggbites #potatocheddareggbites #easymealprep\n\nVideo by caileeeeats", "duration": 30.718000411987305, "extractor": "Instagram", "language": "en", "provider": "www.instagram.com", "thumbnail": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2Fd59a8f8d37794c60a50c97c219e91213.jpg?alt=media", "title": "Video by caileeeeats", "webpage_url": "https://www.instagram.com/reel/DdO_dtaoiI3"}, "recipe": {"cook_time": "30 mins", "cuisine": "American", "description": "vegetarian high protein high fiber low carb keto gluten free balanced Copycat Starbucks Potato Ched.", "diet_flags": ["Vegetarian", "High Protein", "High Fiber", "Low Carb", "Keto", "Gluten Free", "Balanced"], "ingredients": [{"name": "red potatoes", "quantity": "1 lb, diced small"}, {"name": "smoked paprika", "quantity": "1 tsp"}, {"name": "garlic powder", "quantity": "1 tsp"}, {"name": "black pepper", "quantity": "1/2 tsp"}, {"name": "salt", "quantity": "1 tsp"}, {"name": "avocado oil spray", "quantity": "as needed"}, {"name": "large eggs", "quantity": "8"}, {"name": "cottage cheese", "quantity": "1 cup"}, {"name": "onion powder", "quantity": "1/2 tsp"}, {"name": "salt", "quantity": "1/2 tsp"}, {"name": "shredded white cheddar cheese", "quantity": "1 cup"}, {"name": "chopped fresh chives", "quantity": "3 tbsp"}], "instructions": ["Step 1: Preheat the oven and prepare a baking sheet with diced red potatoes.", "Step 2: Season the potatoes with smoked paprika, garlic powder, black pepper, and salt. Spray with avocado oil.", "Step 3: Roast the potatoes in the oven until golden brown.", "Step 4: In a bowl, whisk together the eggs, cottage cheese, onion powder, and salt.", "Step 5: Grease a muffin tin with avocado oil spray.", "Step 6: Fill each muffin cup with the egg mixture and top with roasted potatoes, shredded cheddar cheese, and chopped chives.", "Step 7: Bake in the oven until the egg is set."], "meal_type": "Breakfast", "name": "Copycat Starbucks Potato Cheddar Chive Bakes", "notes": [], "nutrition": {"calcium_mg": "150", "calories": "250", "carbs_g": "30", "cholesterol_mg": "220", "fat_g": "10", "fiber_g": "3", "iron_mg": "1.5", "potassium_mg": "600", "protein_g": "14", "saturated_fat_g": "3", "sodium_mg": "600", "sugar_g": "2", "vitamin_a_mcg": "200", "vitamin_c_mg": "15", "vitamin_d_mcg": "1"}, "prep_time": "20 mins", "servings": "4", "total_time": "50 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2Fd59a8f8d37794c60a50c97c219e91213.jpg?alt=media", "provider": "www.instagram.com", "source_type": "Instagram", "title": "Video by caileeeeats", "type": "video", "url": "https://www.instagram.com/reel/DdO_dtaoiI3"}, "tags": ["Vegetarian", "High Protein", "Eas