{"url": "https://www.halfbakedharvest.com/marry-me-chicken-pasta/", "status": "success", "summary": {"http": 200, "seconds": 8.3, "name": "One Pot Marry Me Chicken Pasta", "n_ingredients": 12, "n_steps": 1, "method": "jsonld", "cached": false, "sample_ingredients": ["1/2 cup oil-packed sun-dried tomatoes, oil drained", "1 pound boneless chicken breasts or thighs, cubed", "salt and black pepper"], "sample_steps": ["1. In a large pot set over medium-high heat, cook the oil from the sun-dried tomato jar with the chicken and 2 teaspoons"]}, "full_response": {"extraction": {"confidence": 0.7, "method": "jsonld"}, "recipe": {"cook_time": "20 mins", "cuisine": "Italian", "description": "high protein low carb keto balanced One Pot Marry Me Chicken Pasta.", "diet_flags": ["High Protein", "Low Carb", "Keto", "Balanced"], "ingredients": [{"name": "1/2 cup oil-packed sun-dried tomatoes, oil drained", "quantity": ""}, {"name": "1 pound boneless chicken breasts or thighs, cubed", "quantity": ""}, {"name": "salt and black pepper", "quantity": ""}, {"name": "4 teaspoons Italian seasoning", "quantity": ""}, {"name": "2 tablespoons salted butter", "quantity": ""}, {"name": "2 cloves garlic, chopped", "quantity": ""}, {"name": "3/4 -1 pound short cut pasta", "quantity": ""}, {"name": "2 cups whole milk", "quantity": ""}, {"name": "2 ounces cream cheese", "quantity": ""}, {"name": "2 cups chopped baby spinach", "quantity": ""}, {"name": "1/2 cup grated parmesan cheese", "quantity": ""}, {"name": "1/2 cup fresh chopped basil", "quantity": ""}], "instructions": ["1. In a large pot set over medium-high heat, cook the oil from the sun-dried tomato jar with the chicken and 2 teaspoons of Italian seasoning. Cook for 5 minutes until the chicken is cooked through. Scoop the chicken out of the pot and set aside.2. Add the butter, garlic, and 2 teaspoons of Italian seasoning. Cook until fragrant, about 2 minutes. Add the pasta and 2 cups of water. Cook, stirring often, until the pasta is al dente, about 8 minutes. Stir in the milk, cream cheese, and parmesan. Mix until creamy.3. Slide the chicken into the pasta, add the spinach, sun-dried tomatoes, and parmesan, and gently mix. Remove from the heat and stir in the basil.4. Serve the pasta immediately with fresh parmesan and basil. Enjoy!"], "meal_type": "Lunch / Dinner", "name": "One Pot Marry Me Chicken Pasta", "nutrition": {"calcium_mg": "250", "calories": "544", "carbs_g": "50", "cholesterol_mg": "90", "fat_g": "24", "fiber_g": "3", "iron_mg": "2", "potassium_mg": "600", "protein_g": "36", "saturated_fat_g": "10", "sodium_mg": "800", "sugar_g": "4", "vitamin_a_mcg": "600", "vitamin_c_mg": "15", "vitamin_d_mcg": "0"}, "prep_time": "15 mins", "servings": "6", "total_time": "35 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F53e6f3e2683a4df6b7054e17836f8c4a.jpg?alt=media", "provider": "www.halfbakedharvest.com", "source_type": "Manual", "title": "One Pot Marry Me Chicken Pasta", "type": "webpage", "url": "https://www.halfbakedharvest.com/marry-me-chicken-pasta/"}, "tags": ["High Protein", "Easy"], "transcript": null}}
{"url": "https://www.halfbakedharvest.com/honey-garlic-chicken/", "status": "success", "summary": {"http": 200, "seconds": 8.6, "name": "30 Minute Honey Garlic Chicken", "n_ingredients": 14, "n_steps": 1, "method": "jsonld", "cached": false, "sample_ingredients": ["2 pounds chicken breasts or thighs, cut into cubes", "1 tablespoon garlic powder", "black pepper and chile flakes"], "sample_steps": ["1. Preheat the oven to 450° F. Line a baking sheet with parchment paper or rub with oil.2. On the sheet pan, mix the chi"]}, "full_response": {"extraction": {"confidence": 0.7, "method": "jsonld"}, "recipe": {"cook_time": "20 mins", "cuisine": "American", "description": "high protein high fiber low carb keto balanced 30 Minute Honey Garlic Chicken.", "diet_flags": ["High Protein", "High Fiber", "Low Carb", "Keto", "Balanced"], "ingredients": [{"name": "2 pounds chicken breasts or thighs, cut into cubes", "quantity": ""}, {"name": "1 tablespoon garlic powder", "quantity": ""}, {"name": "black pepper and chile flakes", "quantity": ""}, {"name": "1/4 cup flour or gluten-free flour", "quantity": ""}, {"name": "4 tablespoons extra virgin olive oil", "quantity": ""}, {"name": "3 cups broccoli florets or chopped asparagus", "quantity": ""}, {"name": "sesame seeds, for serving", "quantity": ""}, {"name": "1/3 cup tamari or soy sauce", "quantity": ""}, {"name": "2 tablespoons lemon juice", "quantity": ""}, {"name": "3 tablespoons honey", "quantity": ""}, {"name": "6 cloves garlic, grated", "quantity": ""}, {"name": "3-4 tablespoons chili paste ((gochjang) (gochujang))", "quantity": ""}, {"name": "2 tablespoons chopped green onion", "quantity": ""}, {"name": "1 tablespoon toasted sesame oil", "quantity": ""}], "instructions": ["1. Preheat the oven to 450° F. Line a baking sheet with parchment paper or rub with oil.2. On the sheet pan, mix the chicken, garlic powder, pepper, and chile flakes. Add the flour and toss again. Add 2 tablespoons olive oil, tossing to coat. Arrange the chicken to one side of the baking sheet. Add the broccoli/asparagus to the other side. Toss with olive oil, salt, and pepper. Bake for 10-15 minutes until the chicken is cooked through.3. Meanwhile, make the sauce. In a bowl or glass jar, combine all ingredients.4. Remove the vegetables from the sheet pan. Then pour the honey garlic sauce over the chicken and toss the chicken up in the sauce. Bake for another 5 minutes, until the sauce is baked onto the chicken.5. Serve the chicken, vegetables, and honey garlic sauce with green onions and toasted sesame seeds. I love this over rice, but it&#39;s also great as an appetizer too!"], "meal_type": "Lunch / Dinner", "name": "30 Minute Honey Garlic Chicken", "nutrition": {"calcium_mg": "50", "calories": "585", "carbs_g": "30", "cholesterol_mg": "90", "fat_g": "15", "fiber_g": "4", "iron_mg": "2", "potassium_mg": "800", "protein_g": "30", "saturated_fat_g": "2", "sodium_mg": "800", "sugar_g": "10", "vitamin_a_mcg": "100", "vitamin_c_mg": "60", "vitamin_d_mcg": "0"}, "prep_time": "10 mins", "servings": "4", "total_time": "30 mins"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2Fecb836c4fee84090ad03970476ccebc5.jpg?alt=media", "provider": "www.halfbakedharvest.com", "source_type": "Manual", "title": "30 Minute Honey Garlic Chicken", "type": "webpage", "url": "https://www.halfbakedharvest.com/honey-garlic-chicken/"}, "tags": ["High Protein", "Quick", "Easy"], "transcript": null}}
{"url": "https://www.instagram.com/reel/Dax39vOx-5L/", "status": "success", "summary": {"http": 200, "seconds": 7.0, "name": "Peanut Butter Chocolate Latte", "n_ingredients": 7, "n_steps": 3, "method": "caption_llm+video_frames_vision", "cached": false, "sample_ingredients": ["2 tsp instant espresso", "1 tbsp peanut butter", "1/2 tbsp chocolate sauce"], "sample_steps": ["Paso 1: Mezcla el espresso instantáneo, la mantequilla de maní, la salsa de chocolate, el jarabe de vainilla, la sal y e", "Paso 2: Agrega la leche de tu elección y mezcla bien."]}, "full_response": {"extraction": {"confidence": 0.5, "method": "caption_llm+video_frames_vision"}, "language": "en", "meta": {"description": "Peanut Butter Chocolate Latte 🥜🍫☕️🤍\n\nQuien no ama chocolate and peanut butter together? This latte takes me back to my childhood rogándole a mi mamá to buy me Reese’s peanut butter cups. It’s chocolaty, nutty, creamy… everything you could want in a cafecito! \n\nFor this latte you’ll need:\n• 2 tsp instant espresso \n• 1 tbsp peanut butter\n• 1/2 tbsp chocolate sauce \n• 1 tbsp vanilla syrup \n• pinch of salt \n• 2 oz water\n• 4-6oz milk of choice \n\n#peanutbutterchocolate #instantcoffee #reesespeanutbuttercups #coffeeathome #coffeerecipes\n\nVideo by fifiscoffee", "duration": 48.132999420166016, "extractor": "Instagram", "language": "en", "provider": "www.instagram.com", "thumbnail": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F152a8f5c2b3a45a79bb56eb2550aac95.jpg?alt=media", "title": "Video by fifiscoffee", "webpage_url": "https://www.instagram.com/reel/Dax39vOx-5L"}, "recipe": {"cook_time": "0 minutos", "cuisine": "American", "description": "vegetarian low carb gluten free balanced Peanut Butter Chocolate Latte.", "diet_flags": ["Vegetarian", "Low Carb", "Gluten Free", "Balanced"], "ingredients": [{"name": "instant espresso", "quantity": "2 tsp"}, {"name": "peanut butter", "quantity": "1 tbsp"}, {"name": "chocolate sauce", "quantity": "1/2 tbsp"}, {"name": "vanilla syrup", "quantity": "1 tbsp"}, {"name": "salt", "quantity": "pinch"}, {"name": "water", "quantity": "2 oz"}, {"name": "milk of choice", "quantity": "4-6 oz"}], "instructions": ["Paso 1: Mezcla el espresso instantáneo, la mantequilla de maní, la salsa de chocolate, el jarabe de vainilla, la sal y el agua en un vaso.", "Paso 2: Agrega la leche de tu elección y mezcla bien.", "Paso 3: Sirve y disfruta."], "meal_type": "Breakfast", "name": "Peanut Butter Chocolate Latte", "notes": [], "nutrition": {"calcium_mg": "150", "calories": "150", "carbs_g": "12", "cholesterol_mg": "10", "fat_g": "9", "fiber_g": "1", "iron_mg": "1", "potassium_mg": "250", "protein_g": "6", "saturated_fat_g": "2", "sodium_mg": "80", "sugar_g": "8", "vitamin_a_mcg": "100", "vitamin_c_mg": "0", "vitamin_d_mcg": "2"}, "prep_time": "5 minutos", "servings": "1", "total_time": "5 minutos"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F152a8f5c2b3a45a79bb56eb2550aac95.jpg?alt=media", "provider": "www.instagram.com", "source_type": "Instagram", "title": "Video by fifiscoffee", "type": "video", "url": "https://www.instagram.com/reel/Dax39vOx-5L"}, "tags": ["Vegetarian", "Quick", "Easy"], "transcript": null}}
{"url": "https://www.instagram.com/reel/DZVXkZJJ3b4/", "status": "success", "summary": {"http": 200, "seconds": 9.9, "name": "Cheeseburger Sliders", "n_ingredients": 10, "n_steps": 11, "method": "caption_llm+video_frames_vision", "cached": false, "sample_ingredients": ["Hawaiian sweet rolls", "1 lb ground beef", "Colby jack cheese"], "sample_steps": ["Preheat the oven to 350°F.", "Layer Hawaiian sweet rolls in a baking dish."]}, "full_response": {"extraction": {"confidence": 0.5, "method": "caption_llm+video_frames_vision"}, "language": "en", "meta": {"description": "Cheeseburger Sliders 🍔\n\n- Hawaiian sweet rolls \n- 1 lb ground beef \n- Colby jack cheese \n- Sauce (1/2 cup mayo, 2 tbsp ketchup, 1 tbsp mustard, 1 tsp pickle juice) \n- melted butter and garlic powder \n- sesame seeds \n\nCover and bake at 350 for 10 minutes and then uncovered for 5 minutes, enjoy! \n\n#sliders #easyrecipes #dinnerideas #easymeals #familymeals\n\nVideo by mama.courtney_", "duration": 60.36600112915039, "extractor": "Instagram", "language": "en", "provider": "www.instagram.com", "thumbnail": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F18320cb3612045b68a28f16b3420e0bd.jpg?alt=media", "title": "Video by mama.courtney_", "webpage_url": "https://www.instagram.com/reel/DZVXkZJJ3b4"}, "recipe": {"cook_time": "15 minutes", "cuisine": "American", "description": "high protein low carb keto gluten free balanced Cheeseburger Sliders.", "diet_flags": ["High Protein", "Low Carb", "Keto", "Gluten Free", "Balanced"], "ingredients": [{"name": "Hawaiian sweet rolls", "quantity": ""}, {"name": "ground beef", "quantity": "1 lb"}, {"name": "Colby jack cheese", "quantity": ""}, {"name": "mayo", "quantity": "1/2 cup"}, {"name": "ketchup", "quantity": "2 tbsp"}, {"name": "mustard", "quantity": "1 tbsp"}, {"name": "pickle juice", "quantity": "1 tsp"}, {"name": "melted butter", "quantity": ""}, {"name": "garlic powder", "quantity": ""}, {"name": "sesame seeds", "quantity": ""}], "instructions": ["Preheat the oven to 350°F.", "Layer Hawaiian sweet rolls in a baking dish.", "Cook ground beef and layer it over the rolls.", "Add slices of Colby jack cheese on top of the beef.", "In a bowl, mix mayo, ketchup, mustard, and pickle juice to create the sauce.", "Drizzle the sauce over the beef and cheese.", "Brush melted butter mixed with garlic powder over the top.", "Sprinkle sesame seeds on top.", "Cover and bake for 10 minutes.", "Uncover and bake for an additional 5 minutes.", "Enjoy!"], "meal_type": "Dinner", "name": "Cheeseburger Sliders", "notes": [], "nutrition": {"calcium_mg": "150", "calories": "350", "carbs_g": "25", "cholesterol_mg": "60", "fat_g": "18", "fiber_g": "1", "iron_mg": "3", "potassium_mg": "350", "protein_g": "20", "saturated_fat_g": "7", "sodium_mg": "600", "sugar_g": "5", "vitamin_a_mcg": "150", "vitamin_c_mg": "1", "vitamin_d_mcg": "0.5"}, "prep_time": "15 mins", "servings": "4", "total_time": "15 minutes"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F18320cb3612045b68a28f16b3420e0bd.jpg?alt=media", "provider": "www.instagram.com", "source_type": "Instagram", "title": "Video by mama.courtney_", "type": "video", "url": "https://www.instagram.com/reel/DZVXkZJJ3b4"}, "tags": ["High Protein", "Medium"], "transcript": null}}
{"url": "https://www.instagram.com/reel/C8xVkmKROF-/", "status": "success", "summary": {"http": 200, "seconds": 7.4, "name": "Monster Cookie Dough Dip", "n_ingredients": 9, "n_steps": 6, "method": "caption_llm+video_frames_vision", "cached": false, "sample_ingredients": ["8 oz. cream cheese", "1 stick butter, softened", "1 cup peanut butter"], "sample_steps": ["Step 1: In a bowl, combine the cream cheese and softened butter.", "Step 2: Mix in the peanut butter until smooth."]}, "full_response": {"extraction": {"confidence": 0.5, "method": "caption_llm+video_frames_vision"}, "language": "en", "meta": {"description": "No oven is required for this delectable Monster Cookie Dough Dip! 🍪 And it’s ready in less than 10 minutes!✨ It’s the easiest dessert that your friends and family will adore🤩 Recipe from: @badbatchbaking #monstercookiedoughdip #monster #cookiedoughdip #monstercookies #cookiedough #dip #dessertdip #peanutbutter #chocolatechips #cookies #easydesserts #dessertrecipes #desserts #summer #summerdesserts #easyIngredients:\n-8 oz. cream cheese\n-1 stick butter, softened\n-1 cup peanut butter\n-1/2 cup oats\n-1/2 cup brown sugar\n-1.5 cups powdered sugar\n-1 cup mini chocolate chips\n-1 cup M&M’s\n-sliced apples and pretzels for dipping\n\nVideo by purewowrecipes", "duration": 21.700000762939453, "extractor": "Instagram", "language": "en", "provider": "www.instagram.com", "thumbnail": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F6c321e7a045e46359702f33283781a30.jpg?alt=media", "title": "Video by purewowrecipes", "webpage_url": "https://www.instagram.com/reel/C8xVkmKROF-"}, "recipe": {"cook_time": "0 minutes", "cuisine": "American", "description": "vegetarian high fiber gluten free balanced Monster Cookie Dough Dip.", "diet_flags": ["Vegetarian", "High Fiber", "Gluten Free", "Balanced"], "ingredients": [{"name": "cream cheese", "quantity": "8 oz."}, {"name": "butter, softened", "quantity": "1 stick"}, {"name": "peanut butter", "quantity": "1 cup"}, {"name": "oats", "quantity": "1/2 cup"}, {"name": "brown sugar", "quantity": "1/2 cup"}, {"name": "powdered sugar", "quantity": "1.5 cups"}, {"name": "mini chocolate chips", "quantity": "1 cup"}, {"name": "M&M’s", "quantity": "1 cup"}, {"name": "sliced apples and pretzels for dipping", "quantity": "for dipping"}], "instructions": ["Step 1: In a bowl, combine the cream cheese and softened butter.", "Step 2: Mix in the peanut butter until smooth.", "Step 3: Add the oats, brown sugar, and powdered sugar, and mix until well combined.", "Step 4: Fold in the mini chocolate chips and M&M’s.", "Step 5: Scoop into a serving bowl and garnish.", "Step 6: Serve with sliced apples and pretzels for dipping."], "meal_type": "Snack", "name": "Monster Cookie Dough Dip", "notes": ["No oven required", "Ready in less than 10 minutes", "Serve with sliced apples and pretzels for dipping"], "nutrition": {"calcium_mg": "40", "calories": "350", "carbs_g": "30", "cholesterol_mg": "40", "fat_g": "25", "fiber_g": "3", "iron_mg": "1.5", "potassium_mg": "200", "protein_g": "6", "saturated_fat_g": "10", "sodium_mg": "150", "sugar_g": "20", "vitamin_a_mcg": "150", "vitamin_c_mg": "0", "vitamin_d_mcg": "0"}, "prep_time": "10 minutes", "servings": "8", "total_time": "10 minutes"}, "source": {"image": "https://firebasestorage.googleapis.com/v0/b/meal-plan-chef.firebasestorage.app/o/recipe-extract-img%2F6c321e7a045e46359702f33283781a30.jpg?alt=media", "provider": "www.instagram.com", "source_type": "Instagram", "title": "Video by purewowrecipes", "type": "video", "url": "https://www.instagram.com/reel/C8xVkmKROF-"}, "tags": ["Vegetarian", "Easy"], "transcript": null}}
